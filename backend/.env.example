# Copy to backend/.env and adjust. List values are JSON arrays.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:4200"]

# Local inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Cloud inference (OpenAI-compatible). Leave CLOUD_API_KEY empty to use simulated responses.
CLOUD_ENABLED=true
CLOUD_PROVIDER_NAME=Approved Cloud LLM
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_DEFAULT_MODEL=gpt-4o-mini
CLOUD_MODELS=["gpt-4o-mini","gpt-4o"]

# Routing
ROUTING_COMPLEX_MIN_CHARS=600
ROUTING_ALLOW_FALLBACK=true
